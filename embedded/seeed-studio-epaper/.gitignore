# Flash images are large (32 MB each) and do not belong in a GitHub Pages repo.
# Keep them on disk and mirror them somewhere outside git.
firmware-backup/*.bin
firmware-backup/**/*.bin
firmware-backup/*.parts/

# Local esptool environment
.venv/

# Wi-Fi credentials — this repo publishes to GitHub Pages.
# Unanchored so it matches every sketch folder that needs a copy, not just the
# first one. An anchored "dashboard/secrets.h" missed firmware/dashboard/.
**/secrets.h
