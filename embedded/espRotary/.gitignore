# Flash images are large and do not belong in a GitHub Pages repo.
# Keep them on disk and mirror them somewhere outside git.
firmware-backup/*.bin
firmware-backup/**/*.bin

# Wi-Fi and other credentials
**/secrets.h

# Tuya local keys — treat as passwords. devices.known.json holds names and
# addresses only and is safe to track.
devices/devices.secret.json
devices/tinytuya.json
devices/raw.json
**/devices.json
# Both of these carry a local_key per device, straight from the discovery
# broadcast and the cloud listing. This repository publishes to GitHub Pages.
devices/snapshot.json
devices/tuya-raw.json

# Local toolchain
.venv/

# Generated device table — contains local keys
**/devices_secret.h
