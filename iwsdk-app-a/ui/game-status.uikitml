<style>
  .root {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #09090b;
    border-color: #27272a;
    border-width: 0.15;
    border-radius: 2.5;
    padding: 3;
    width: 72;
  }

  /* ── Menu screen ───────────────────────────────────────── */
  #menu-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .menu-title {
    font-size: 5;
    font-weight: bold;
    color: #fafafa;
    text-align: center;
    margin-bottom: 3;
  }
  .mode-btn {
    width: 100%;
    padding: 2;
    margin-bottom: 1.2;
    background-color: #18181b;
    color: #e4e4e7;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3;
    text-align: center;
    cursor: pointer;
  }
  #qr-btn {
    width: 100%;
    padding: 1.5;
    margin-top: 2;
    background-color: #18181b;
    color: #a1a1aa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #52525b;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #exit-btn {
    width: 100%;
    padding: 1.5;
    margin-top: 1;
    background-color: #18181b;
    color: #3f3f46;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #27272a;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }

  /* ── Game screen ───────────────────────────────────────── */
  #game-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  #mode-title {
    font-size: 3;
    color: #71717a;
    text-align: center;
    margin-bottom: 1.5;
  }

  /* Turn / result — only one shows at a time */
  #turn-yours  { font-size: 5;   font-weight: bold; color: #22cc55; text-align: center; }
  #turn-ai     { font-size: 5;   font-weight: bold; color: #ffaa00; text-align: center; display: none; }
  #result-win  { font-size: 5.5; font-weight: bold; color: #facc15; text-align: center; display: none; }
  #result-lose { font-size: 5.5; font-weight: bold; color: #ff4444; text-align: center; display: none; }
  #result-draw { font-size: 5.5; font-weight: bold; color: #a1a1aa; text-align: center; display: none; }

  .divider {
    width: 100%;
    height: 0.12;
    background-color: #27272a;
    margin-top: 2;
    margin-bottom: 1.5;
  }

  .score-row {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
  }
  .score-item  { display: flex; flex-direction: column; align-items: center; }
  .score-caption { font-size: 2.5; color: #71717a; text-align: center; }
  #you-score   { font-size: 7; font-weight: bold; color: #2277ff; text-align: center; }
  #draw-score  { font-size: 7; font-weight: bold; color: #a1a1aa; text-align: center; }
  #ai-score    { font-size: 7; font-weight: bold; color: #ff5522; text-align: center; }

  .action-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 2;
  }
  #reset-btn {
    width: 32;
    padding: 2;
    margin-right: 2;
    background-color: #27272a;
    color: #a1a1aa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #change-btn {
    width: 32;
    padding: 2;
    background-color: #1e3a5f;
    color: #93c5fd;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #2563eb;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }

  /* ── Cornhole screen ───────────────────────────────────── */
  #cornhole-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  #ch-title {
    font-size: 5;
    font-weight: bold;
    color: #fafafa;
    text-align: center;
    margin-bottom: 1.5;
  }
  #ch-bags {
    font-size: 5;
    text-align: center;
    margin-bottom: 1.5;
    letter-spacing: 1;
  }
  .ch-score-row {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    width: 100%;
    margin-bottom: 1;
  }
  #ch-round-score {
    font-size: 8;
    font-weight: bold;
    color: #f97316;
    text-align: center;
  }
  #ch-best-score {
    font-size: 8;
    font-weight: bold;
    color: #facc15;
    text-align: center;
  }
  .ch-toggle-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 1.5;
  }
  #ch-grab-btn {
    width: 32;
    padding: 2;
    margin-right: 2;
    background-color: #1e3a5f;
    color: #93c5fd;
    border-radius: 1.5;
    border-width: 0.15;
    border-color: #2563eb;
    font-size: 3.5;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
  }
  #ch-lob-btn {
    width: 32;
    padding: 2;
    background-color: #18181b;
    color: #52525b;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3.5;
    text-align: center;
    cursor: pointer;
  }
  #ch-arc-btn {
    width: 100%;
    padding: 1.8;
    margin-top: 1;
    background-color: #18181b;
    color: #52525b;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3;
    text-align: center;
    cursor: pointer;
    display: none;
  }
  .ch-action-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 2;
  }
  #ch-new-round-btn {
    width: 32;
    padding: 2;
    margin-right: 2;
    background-color: #14532d;
    color: #86efac;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #16a34a;
    font-size: 3;
    text-align: center;
    cursor: pointer;
  }
  #ch-menu-btn {
    width: 32;
    padding: 2;
    background-color: #27272a;
    color: #a1a1aa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3;
    text-align: center;
    cursor: pointer;
  }

  /* ── Railroad screen ───────────────────────────────────────── */
  #railroad-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  #rr-title {
    font-size: 5;
    font-weight: bold;
    color: #fafafa;
    text-align: center;
    margin-bottom: 2;
  }
  #rr-track-count {
    font-size: 3;
    color: #71717a;
    text-align: center;
    margin-bottom: 1.5;
  }
  .rr-btn-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 1.5;
  }
  #rr-track-btn {
    width: 32;
    padding: 2;
    margin-right: 2;
    background-color: #1c3a2e;
    color: #6ee7b7;
    border-radius: 1.5;
    border-width: 0.15;
    border-color: #059669;
    font-size: 3;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
  }
  #rr-train-btn {
    width: 32;
    padding: 2;
    background-color: #3b2e1c;
    color: #fcd34d;
    border-radius: 1.5;
    border-width: 0.15;
    border-color: #d97706;
    font-size: 3;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
  }
  #rr-clear-btn {
    width: 32;
    padding: 2;
    margin-right: 2;
    background-color: #27272a;
    color: #a1a1aa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3;
    text-align: center;
    cursor: pointer;
  }
  #rr-menu-btn {
    width: 32;
    padding: 2;
    background-color: #27272a;
    color: #a1a1aa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3;
    text-align: center;
    cursor: pointer;
  }
  #rr-debug-btn {
    width: 100%;
    padding: 1.5;
    margin-top: 1.5;
    background-color: #18181b;
    color: #52525b;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #rr-debug-btn.active {
    background-color: #1a2a1a;
    color: #86efac;
    border-color: #16a34a;
  }
  #rr-scan-btn {
    width: 100%;
    padding: 2;
    margin-top: 1.5;
    background-color: #3b2a0c;
    color: #fbbf24;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #d97706;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }

  /* ── Basketball screen ───────────────────────────────────── */
  #basketball-screen {
    display: none;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  #bball-title {
    font-size: 5;
    font-weight: bold;
    color: #fafafa;
    text-align: center;
    margin-bottom: 1.5;
  }
  #bball-status {
    font-size: 3;
    color: #71717a;
    text-align: center;
    margin-bottom: 2;
  }
  #bball-row-1 {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 1;
  }
  #bball-row-2 {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-top: 1;
  }
  #bball-mode-current {
    width: 32;
    padding: 1.5;
    margin-right: 2;
    background-color: #1e3a5f;
    color: #93c5fd;
    border-radius: 1.5;
    border-width: 0.15;
    border-color: #2563eb;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #bball-mode-a {
    width: 32;
    padding: 1.5;
    background-color: #18181b;
    color: #71717a;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #bball-mode-b {
    width: 32;
    padding: 1.5;
    margin-right: 2;
    background-color: #18181b;
    color: #71717a;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #bball-mode-d {
    width: 32;
    padding: 1.5;
    background-color: #18181b;
    color: #71717a;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 2.5;
    text-align: center;
    cursor: pointer;
  }
  #bball-menu-btn {
    width: 100%;
    padding: 2;
    margin-top: 2;
    background-color: #27272a;
    color: #a1a1aa;
    border-radius: 1.5;
    border-width: 0.1;
    border-color: #3f3f46;
    font-size: 3;
    text-align: center;
    cursor: pointer;
  }
</style>

<div class="root">

  <!-- ═══════════ MENU SCREEN ═══════════ -->
  <div id="menu-screen">
    <span class="menu-title">Choose Your Game</span>
    <button id="mode-0" class="mode-btn">Tic-Tac-Toe</button>
    <button id="mode-1" class="mode-btn">Connect 3</button>
    <button id="mode-2" class="mode-btn">Connect 4</button>
    <button id="mode-3" class="mode-btn">Connect 5</button>
    <button id="mode-4" class="mode-btn">Connect 6</button>
    <button id="mode-5" class="mode-btn">Cornhole</button>
    <button id="mode-6" class="mode-btn">Model Railroad</button>
    <button id="mode-7" class="mode-btn">Watch Basketball</button>
    <button id="qr-btn">QR Code</button>
    <button id="exit-btn">Exit to Browser</button>
  </div>

  <!-- ═══════════ GAME SCREEN ═══════════ -->
  <div id="game-screen">
    <span id="mode-title">Tic-Tac-Toe</span>

    <span id="turn-yours">▼  YOUR TURN</span>
    <span id="turn-ai">⏳  AI THINKING…</span>
    <span id="result-win">🎉  YOU WIN!</span>
    <span id="result-lose">AI WINS</span>
    <span id="result-draw">DRAW</span>

    <div class="divider"></div>

    <div class="score-row">
      <div class="score-item">
        <span class="score-caption">YOU (X)</span>
        <span id="you-score">0</span>
      </div>
      <div class="score-item">
        <span class="score-caption">DRAWS</span>
        <span id="draw-score">0</span>
      </div>
      <div class="score-item">
        <span class="score-caption">AI (O)</span>
        <span id="ai-score">0</span>
      </div>
    </div>

    <div class="action-row">
      <button id="reset-btn">Reset Score</button>
      <button id="change-btn">Change Game</button>
    </div>
  </div>

  <!-- ═══════════ RAILROAD SCREEN ═══════════ -->
  <div id="railroad-screen">
    <span id="rr-title">Model Railroad</span>
    <span id="rr-track-count">0 pieces · 0 trains</span>

    <div class="divider"></div>

    <div class="rr-btn-row">
      <button id="rr-track-btn">+ Track</button>
      <button id="rr-train-btn">+ Train</button>
    </div>
    <div class="rr-btn-row">
      <button id="rr-clear-btn">Clear All</button>
      <button id="rr-menu-btn">Menu</button>
    </div>
    <button id="rr-scan-btn">Scan Room</button>
    <button id="rr-debug-btn">Debug: Off</button>
  </div>

  <!-- ═══════════ BASKETBALL SCREEN ═══════════ -->
  <div id="basketball-screen">
    <span id="bball-title">Basketball</span>
    <span id="bball-status">Loading stream…</span>

    <div class="divider"></div>

    <div id="bball-row-1">
      <button id="bball-mode-current">Current</button>
      <button id="bball-mode-a">Closer</button>
    </div>
    <div id="bball-row-2">
      <button id="bball-mode-b">Aniso Filt</button>
      <button id="bball-mode-d">XR Layer</button>
    </div>

    <button id="bball-menu-btn">Menu</button>
  </div>

  <!-- ═══════════ CORNHOLE SCREEN ═══════════ -->
  <div id="cornhole-screen">
    <span id="ch-title">Cornhole</span>
    <span id="ch-bags">● ● ● ●</span>

    <div class="ch-score-row">
      <div class="score-item">
        <span class="score-caption">ROUND</span>
        <span id="ch-round-score">0</span>
      </div>
      <div class="score-item">
        <span class="score-caption">BEST</span>
        <span id="ch-best-score">0</span>
      </div>
    </div>

    <div class="divider"></div>

    <div class="ch-toggle-row">
      <button id="ch-grab-btn">Grab</button>
      <button id="ch-lob-btn">Lob</button>
    </div>
    <button id="ch-arc-btn">Arc Preview: Off</button>

    <div class="ch-action-row">
      <button id="ch-new-round-btn">New Round</button>
      <button id="ch-menu-btn">Menu</button>
    </div>
  </div>

</div>
